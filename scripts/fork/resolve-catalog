#!/usr/bin/env python3
"""Resolves and checks Localizable.xcstrings conflicts during an upstream rebase (FORK.md § Upstream rebase).

    scripts/fork/resolve-catalog merge
    scripts/fork/resolve-catalog check <old-base> <old-tip> <new-base> [<new-tip>]

The catalog opens with a block of one-line entries in key order. Upstream and the fork both add strings
there, so a rebase conflicts on it nearly every time. `merge` resolves every conflict in the working
tree's catalog by keeping each side's entries once, sorted by key; it refuses a hunk that is not
one-line entries. Then `git add` the catalog and continue the rebase.

A union keeps a key that the replayed commit deleted or moved elsewhere, and `json.load` silently keeps
the last of two duplicate keys, so nothing fails at build or test time. Once the rebase is done, `check`
compares every key: one the fork's commits (old-base..old-tip) added or changed must match old-tip, one
they deleted must be gone, and every other key must match new-base. It also reports duplicate keys
new-tip has and new-base does not. Exits 1 on any difference.
"""
import json
import re
import subprocess
import sys

CATALOG = "HermesMobile/Resources/Localizable.xcstrings"
HUNK = re.compile(r"^<<<<<<< [^\n]*\n(.*?)^(?:\|\|\|\|\|\|\| [^\n]*\n.*?)?^=======\n(.*?)^>>>>>>> [^\n]*\n",
                  re.S | re.M)
KEY = re.compile(r'\s*("(?:[^"\\]|\\.)*")\s*:')


def entry_key(line):
    match = KEY.match(line)
    if not match or not line.rstrip().endswith(("},", "}")):
        raise ValueError(f"not a one-line catalog entry: {line[:80]}")
    return json.loads(match.group(1))


def merge():
    with open(CATALOG, encoding="utf-8") as f:
        text = f.read()

    def union(hunk):
        lines = {}
        for side in (hunk.group(1), hunk.group(2)):
            for line in side.splitlines():
                key = entry_key(line)
                if key in lines and lines[key] != line:
                    print(f"both sides changed {key!r}; kept the upstream side, check it by hand", file=sys.stderr)
                lines.setdefault(key, line)
        return "".join(lines[key] + "\n" for key in sorted(lines))

    try:
        merged, count = HUNK.subn(union, text)
    except ValueError as error:
        sys.exit(f"{error}\nResolve this hunk by hand.")
    if "<<<<<<< " in merged or ">>>>>>> " in merged:
        sys.exit("Some conflict markers are left; resolve them by hand.")
    json.loads(merged)
    with open(CATALOG, "w", encoding="utf-8") as f:
        f.write(merged)
    print(f"Resolved {count} conflict(s) in {CATALOG}.")


def load(ref):
    raw = subprocess.check_output(["git", "show", f"{ref}:{CATALOG}"])
    duplicates = []

    def pairs(items):
        seen = set()
        for key, _ in items:
            if key in seen:
                duplicates.append(key)
            seen.add(key)
        return dict(items)

    return json.loads(raw, object_pairs_hook=pairs)["strings"], set(duplicates)


def check(old_base, old_tip, new_base, new_tip="HEAD"):
    (before, _), (fork, _) = load(old_base), load(old_tip)
    (upstream, upstream_dups), (result, result_dups) = load(new_base), load(new_tip)
    problems = [f"duplicate key: {key!r}" for key in sorted(result_dups - upstream_dups)]
    ours = {key for key in before.keys() | fork.keys() if before.get(key) != fork.get(key)}
    for key in sorted(ours):
        if key not in fork and key in result:
            problems.append(f"the fork deleted {key!r} but it is back")
        elif key in fork and result.get(key) != fork[key]:
            problems.append(f"the fork's {key!r} differs from {old_tip}")
    for key in sorted((upstream.keys() | result.keys()) - ours):
        if result.get(key) != upstream.get(key):
            problems.append(f"{key!r} differs from {new_base}")
    for problem in problems:
        print(problem, file=sys.stderr)
    if problems:
        sys.exit(1)
    print(f"All {len(result)} keys match: {len(ours)} from the fork's commits, the rest from {new_base}.")


if __name__ == "__main__":
    args = sys.argv[1:]
    if args == ["merge"]:
        merge()
    elif args[:1] == ["check"] and len(args) in (4, 5):
        check(*args[1:])
    else:
        sys.exit(__doc__)
